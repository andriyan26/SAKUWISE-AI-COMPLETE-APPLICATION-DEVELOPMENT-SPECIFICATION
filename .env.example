# ==============================================================================
# SAKUWISE AI — ENVIRONMENT CONFIGURATION (.env.example)
# Smart Finance, Brighter Future
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MySQL on Laragon or Local Server)
DATABASE_URL="mysql://root:@localhost:3306/sakuwise_ai"

# Authentication Secrets (Generate secure random 64-char strings in production)
SESSION_SECRET=sakuwise_super_secure_session_secret_change_in_production
ACCESS_TOKEN_SECRET=sakuwise_jwt_access_secret_super_key_2026_finance
REFRESH_TOKEN_SECRET=sakuwise_jwt_refresh_secret_super_key_2026_finance

# AI Engine Configuration
# Supported AI_PROVIDER: "mock" (built-in offline agent), "openai", "gemini"
AI_PROVIDER=mock
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Storage Configuration (Local or S3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# OCR Provider Configuration (Simulated local parser or cloud OCR)
OCR_PROVIDER=mock
OCR_API_KEY=

# Email Provider Configuration (Password reset tokens)
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=no-reply@sakuwise.ai
