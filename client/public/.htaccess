# ----------------------------------------------------------------------
# SAKUWISE AI — Hostinger Apache Configuration
# ----------------------------------------------------------------------

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType audio/mpeg .mp3
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route API requests directly to the native PHP API handler
  RewriteRule ^api/v1/(.*)$ api/v1/index.php [QSA,L]
  RewriteRule ^api/(.*)$ api/v1/index.php [QSA,L]

  # 2. Never rewrite missing static assets to index.html (return 404 directly)
  # This prevents Hostinger CDN from caching index.html for .js/.css/.mp3 requests
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf|map|json|mp3)$ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(assets|voices)/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # 3. Frontend React SPA routes
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML pages should not be cached by CDN to guarantee immediate app updates
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Versioned/hashed static assets can be safely cached
  <FilesMatch "\.(js|mjs|css|woff2|woff|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

